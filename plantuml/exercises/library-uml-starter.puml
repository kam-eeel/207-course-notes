@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

' Design notes:
' - Member and Librarian share no behaviour beyond "can log in". That common part
'   lives in LibrarySession, and the session subtype decides what a logged-in user
'   may do, so there is no Member/Librarian supertype.
' - Sessions are not nouns in the spec; they are added to enforce "only librarians
'   can add items / waive late fees". All classes share one package: logging in is
'   the only way to get a session (package-private constructors), and Library's
'   state-changing operations are package-private (~), so only sessions reach them.
' - Whether an item is on loan is recorded twice (BorrowableItem.onLoan and
'   Library.loans). Library.borrow and Library.returnItem keep the two in sync;
'   the trade-off is discussed in Question 2.

abstract class LibrarySession {
  # library : Library
}
LibrarySession --> "1" Library

LibrarySession <|-- MemberSession
class MemberSession {
  - member : Member
  ~ MemberSession(library : Library, member : Member)
  + borrow(item : BorrowableItem) : Loan
  + returnItem(item : BorrowableItem) : void
  + placeHold(item : BorrowableItem) : Hold
  + getLoans() : List<Loan>
  + getHolds() : List<Hold>
}
MemberSession --> "1" Member

LibrarySession <|-- StaffSession
class StaffSession {
  - librarian : Librarian
  ~ StaffSession(library : Library, librarian : Librarian)
  + addItem(item : Item) : boolean
  + waiveLateFee(member : Member) : void
}
StaffSession --> "1" Librarian

class Library {
  - catalogue : Catalogue
  - members : List<Member>
  - staff : List<Librarian>
  - loans : List<Loan>
  - holds : List<Hold>
  + memberLogin(memberNumber : String) : MemberSession
  + staffLogin(staffNumber : String) : StaffSession
  + findItem(catalogueNumber : String) : Item
  ~ borrow(member : Member, item : BorrowableItem) : Loan
  ~ placeHold(member : Member, item : BorrowableItem) : Hold
  ~ returnItem(item : BorrowableItem) : void
  ~ loansFor(member : Member) : List<Loan>
  ~ holdsFor(member : Member) : List<Hold>
  ~ addItem(item : Item) : boolean
  ~ waiveLateFee(member : Member) : void
}
Library o--> "1" Catalogue
Library o--> "*" Member
Library o--> "*" Librarian
Library o--> "*" Loan
Library o--> "*" Hold

class Catalogue {
  - items : List<Item>
  + findByNumber(n : String) : Item
  ~ addItem(item : Item) : boolean
}

Catalogue o--> "*" Item
abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

Item <|-- ReferenceItem

Item <|-- BorrowableItem
abstract class BorrowableItem {
  - onLoan : boolean
  + isOnLoan() : boolean
  ~ loan() : boolean
  ~ markReturned() : void
  + {abstract} loanPeriod() : int
}

BorrowableItem <|-- Book
class Book {
  - {static} LOAN_PERIOD_DAYS : int
  + loanPeriod() : int
}

BorrowableItem <|-- DVD
class DVD {
  - {static} LOAN_PERIOD_DAYS : int
  + loanPeriod() : int
}

class Loan {
  - member : Member
  - item : BorrowableItem
  - borrowDate : Date
  - dueDate : Date
  + getMember() : Member
  + getItem() : BorrowableItem
}
Loan --> "1" BorrowableItem
Loan --> "1" Member

class Hold {
  - member : Member
  - item : BorrowableItem
  - datePlaced : Date
  + getMember() : Member
  + getItem() : BorrowableItem
}
Hold --> "1" BorrowableItem
Hold --> "1" Member

class Member {
  - memberNumber : String
  - lateFee : double
  + getMemberNumber() : String
  + getLateFee() : double
  ~ clearLateFee() : void
}

class Librarian {
  - staffNumber : String
  + getStaffNumber() : String
}

@enduml
